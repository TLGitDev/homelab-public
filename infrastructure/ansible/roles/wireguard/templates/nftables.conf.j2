#!/usr/sbin/nft -f
flush ruleset

table inet acces {
    chain forward {
        type filter hook forward priority 0; policy drop;
        ct state established,related accept
{% for dest in acces_destinations %}
        iifname "wg0" ip daddr {{ dest.addr }} {{ dest.proto }} dport {{ dest.port }} accept
{% endfor %}
    }

    chain postrouting {
        type nat hook postrouting priority 100; policy accept;
        ip saddr {{ acces_network }} oifname "eth0" masquerade
    }
}
