[Interface]
Address = {{ peer_address }}
PrivateKey = {{ peer_private }}
DNS = {{ acces_dns }}

[Peer]
PublicKey = {{ acces_server_public }}
Endpoint = {{ acces_endpoint }}
AllowedIPs = {{ ([acces_dns] + acces_destinations | map(attribute='addr') | unique | list) | join('/32, ') }}/32
PersistentKeepalive = 25
