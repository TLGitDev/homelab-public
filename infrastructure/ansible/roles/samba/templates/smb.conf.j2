[global]
	workgroup = WORKGROUP
	server string = homelab
	security = user
	map to guest = never
	server min protocol = SMB3
	smb ports = 445
	disable netbios = yes
	interfaces = {{ samba_bind_address }}
	bind interfaces only = yes
	hosts allow = <réseau-lan>
	hosts deny = 0.0.0.0/0
	logging = syslog@1
	load printers = no
	printing = bsd
	printcap name = /dev/null
	disable spoolss = yes

[documents]
	path = /tank/documents
	browseable = yes
	read only = no
	valid users = utilisateur
	force user = utilisateur
	force group = perso
	create mask = 0660
	directory mask = 0770
	veto files = /._*/.DS_Store/Thumbs.db/

