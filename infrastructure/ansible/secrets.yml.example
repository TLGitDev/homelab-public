# Modèle du fichier secrets.yml. Ce fichier-ci n'a pas de secret.
# Copier vers secrets.yml. Git ignore secrets.yml.

# Jeton d'API créé sur pve pour le compte root@pam.
proxmox_api_token_id: root@pam!ansible
proxmox_api_token_secret: ""
# Mot de passe root des conteneurs créés par les playbooks. Pas celui de pve.
runner_root_password: ""
# Jeton d'enregistrement Gitea. Sert seulement à playbooks/runner.yml --tags register.
gitea_runner_registration_token: ""
